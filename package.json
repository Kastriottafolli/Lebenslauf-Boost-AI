{
  "name": "candidaro",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "python3 scripts/build_pages.py && node scripts/bundle_pages.mjs",
    "test": "node --test frontend/tests/*.test.js",
    "dev": "python3 -m uvicorn backend.main:app --reload",
    "mobile:sync": "npm run build && cap sync",
    "mobile:android": "cap open android",
    "mobile:ios": "cap open ios",
    "check": "npm test && npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/camera": "^8.2.5",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/share": "^8.0.3",
    "@pdf-lib/fontkit": "1.1.1",
    "docx": "9.7.1",
    "fflate": "^0.8.3",
    "mammoth": "1.12.3",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.3.289",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.3",
    "esbuild": "0.28.2"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
