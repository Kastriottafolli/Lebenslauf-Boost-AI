# No secrets are required for local demos. Never commit .env.
APP_NAME=Candidaro
DATABASE_URL=sqlite:///./data/app.db
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,capacitor://localhost,https://localhost
SECURE_COOKIES=false
RETENTION_DAYS=30
# Set a purchased, configured HTTPS domain before production; also used at build time.
SITE_URL=
OPERATOR_NAME=
OPERATOR_ADDRESS=
OPERATOR_EMAIL=
# User API keys remain per-request. Server keys require login and must be opt-in.
ALLOW_SERVER_KEYS=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROK_API_KEY=
GROK_MODEL=grok-4.7
AZURE_API_KEY=
AZURE_MODEL=
AZURE_ENDPOINT=
