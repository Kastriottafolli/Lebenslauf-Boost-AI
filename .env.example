# No secrets are required for local demos. Never commit .env.
APP_NAME=Boosty AI
DATABASE_URL=sqlite:///./data/tafolli.db
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,capacitor://localhost,https://localhost
SECURE_COOKIES=false
RETENTION_DAYS=30
# Local preview: leave SITE_URL empty. Public HTTPS configuration: .env.production.example.
SITE_URL=
OPERATOR_NAME="Kastriot Tafolli"
OPERATOR_ADDRESS="Hauptstraße 1\n18609 Ostseebad Binz\nDeutschland"
OPERATOR_EMAIL=info@tafolli.net
# User API keys remain per-request. Server keys require login and must be opt-in.
ALLOW_SERVER_KEYS=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROK_API_KEY=
GROK_MODEL=grok-4.7
AZURE_API_KEY=
AZURE_MODEL=
AZURE_ENDPOINT=

# Operator-paid SOFTWARE HELP ONLY. Add a separate restricted OpenAI project key locally.
# Never use this secret in frontend code, chat or the general OPENAI_API_KEY field.
BOOSTY_ENABLED=false
BOOSTY_OPENAI_API_KEY=
BOOSTY_OPENAI_MODEL=gpt-6-luna
BOOSTY_DAILY_LIMIT=500
BOOSTY_SESSION_DAILY_LIMIT=20
