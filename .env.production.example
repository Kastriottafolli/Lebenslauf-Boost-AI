# Purchased app domain; configure DNS and hosting before starting production.
# The existing tafolli.net homepage stays where it is.
APP_DOMAIN=tafolliboost.com
SITE_URL=https://tafolliboost.com
APP_NAME=tafolliboost.com
DATABASE_URL=sqlite:///./data/tafolli.db
ALLOWED_HOSTS=tafolliboost.com,www.tafolliboost.com,localhost,127.0.0.1
ALLOWED_ORIGINS=https://tafolliboost.com,capacitor://localhost,https://localhost
SECURE_COOKIES=true
# Keep MFA on by default; the operator may explicitly choose password-only sign-in.
ADMIN_REQUIRE_TOTP=true
RETENTION_DAYS=30
OPERATOR_NAME="Kastriot Tafolli"
OPERATOR_ADDRESS="Hauptstraße 1\n18609 Ostseebad Binz\nDeutschland"
OPERATOR_EMAIL=info@tafolli.net
# Centrally funded service. Never commit real values.
HOSTED_AI_ENABLED=true
ALLOW_SERVER_KEYS=false
OPENAI_API_KEY=
HOSTED_OPENAI_MODEL=gpt-4.1-mini
HOSTED_HELP_MODEL=gpt-4.1-mini
AI_GLOBAL_DAILY_CALLS=300
AI_ACCOUNT_DAILY_PACKAGES=20
AI_ACCOUNT_DAILY_REFINES=10
AI_ACCOUNT_DAILY_HELP=30
AI_DAILY_BUDGET_USD=5
# Change prices together with the model. Estimates are not an OpenAI invoice.
AI_INPUT_USD_PER_MILLION=0.4
AI_OUTPUT_USD_PER_MILLION=1.6
# Three free packages per calendar week (Monday, Europe/Berlin); purchased credits persist.
BILLING_FREE_PACKAGES=3
BILLING_SINGLE_CENTS=199
BILLING_BUNDLE10_CENTS=999
# Payment preparation only. Never enable before sandbox and legal launch review.
BILLING_PAYMENTS_ENABLED=false
BILLING_ENVIRONMENT=sandbox
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MERCHANT_ID=
# Social login stays unavailable until provider apps are approved/configured.
OAUTH_BASE_URL=https://tafolliboost.com
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_APPLE_CLIENT_ID=
OAUTH_APPLE_CLIENT_SECRET=
OAUTH_FACEBOOK_CLIENT_ID=
OAUTH_FACEBOOK_CLIENT_SECRET=
OAUTH_X_CLIENT_ID=
OAUTH_X_CLIENT_SECRET=
OAUTH_FACEBOOK_VERSION=v25.0

# Transactional account email: verified TLS; configure one real transport.
MAIL_TRANSPORT=smtp
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURITY=starttls
SMTP_FROM_EMAIL=info@tafolli.net
SMTP_FROM_NAME=TafolliBoost
MAIL_RELAY_URL=
# Optional fixed public server IP; TLS still verifies the URL hostname.
MAIL_RELAY_CONNECT_IP=
MAIL_RELAY_SECRET=
MAIL_KEY_FILE=./data/mail-secrets.key
MAIL_POLL_SECONDS=15
